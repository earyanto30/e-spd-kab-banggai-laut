generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String?  @unique
  name      String
  role      String   @default("USER") // Matches Role in @si-setda/shared-types: SUPER_ADMIN, ADMIN, STAFF, USER
  password  String
  isActive  Boolean  @default(true)

  pegawaiId String?  @unique
  pegawai   Pegawai? @relation(fields: [pegawaiId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KopSurat {
  id             String   @id @default(cuid())
  nama           String
  keterangan     String?
  fileName       String
  storedFileName String
  fileSize       String
  paperSize      String   @default("A4")
  tipeSurat      String?  @default("SPD")
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  spdList        Spd[]
}

model Pegawai {
  id        String   @id @default(cuid())
  nip       String   @unique
  nama      String
  pangkat   String
  golongan  String
  jabatan   String
  unitKerja String   @default("Sekretariat Daerah")
  isASN           Boolean  @default(true)
  isPenandatangan Boolean  @default(false)
  tandaTangan     String?

  user                         User?
  spdList                      Spd[]        @relation("SpdPelaksana")
  spdDitandatanganiList        Spd[]        @relation("SpdPenandatangan")
  suratTugasDitandatanganiList SuratTugas[] @relation("SuratTugasPenandatangan")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Spd {
  id               String      @id @default(cuid())
  nomorSpd         String      @unique
  pemberiPerintah  String
  pegawaiId        String
  pegawai          Pegawai     @relation("SpdPelaksana", fields: [pegawaiId], references: [id])
  dalamRangka      String
  alatAngkut       String
  tempatBerangkat  String
  tempatTujuan     String
  lamaHari         Int
  tanggalBerangkat DateTime
  tanggalKembali   DateTime
  skpd             String      @default("Bagian Umum Sekretariat Daerah Kab. Banggai Laut")
  kodeRekening     String?
  tingkatBiaya     String?
  pengikut         String?
  keterangan       String?
  kopSuratId       String?
  kopSurat         KopSurat?   @relation(fields: [kopSuratId], references: [id], onDelete: SetNull)
  suratTugasId     String?
  suratTugas       SuratTugas? @relation(fields: [suratTugasId], references: [id], onDelete: SetNull)
  penandatanganId  String?
  penandatangan    Pegawai?    @relation("SpdPenandatangan", fields: [penandatanganId], references: [id], onDelete: SetNull)
  penandatanganNama     String?
  penandatanganJabatan  String?
  penandatanganPangkat  String?
  penandatanganNip      String?
  status           String      @default("DRAFT")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model SuratTugas {
  id              String   @id @default(cuid())
  nomorSurat      String   @unique
  dasarHukum      String   @default("Undang-undang Nomor 09 Tahun 2015 tentang Perubahan kedua atas Undang-undang Nomor 23 Tahun 2014 tentang Pemerintahan Daerah (Lembaran Negara Republik Indonesia Tahun 2015 Nomor 5679)")
  dalamRangka     String
  tempatDikeluarkan String @default("Banggai")
  tanggalSurat    DateTime @default(now())
  penandatanganId String?
  penandatangan   Pegawai? @relation("SuratTugasPenandatangan", fields: [penandatanganId], references: [id], onDelete: SetNull)
  penandatanganNama     String @default("ARSID HAMIDI, SH")
  penandatanganJabatan  String @default("KEPALA BAGIAN UMUM SETDA KAB. BANGGAI LAUT")
  penandatanganPangkat  String @default("Pembina, IV/a")
  penandatanganNip      String @default("19700830 200312 1 003")
  kopSuratId      String?
  pegawaiIds      String?
  alatAngkut      String?
  tempatTujuan    String?
  lamaHari        Int?     @default(1)
  tanggalBerangkat DateTime?
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  spdList         Spd[]
}

