generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String?  @unique
  name      String
  role      String   @default("USER") // Matches Role in @si-setda/shared-types: SUPER_ADMIN, ADMIN, STAFF, USER
  password  String
  isActive  Boolean  @default(true)

  pegawaiId String?  @unique
  pegawai   Pegawai? @relation(fields: [pegawaiId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KopSurat {
  id             String   @id @default(cuid())
  nama           String
  keterangan     String?
  fileName       String
  storedFileName String
  fileSize       String
  paperSize      String   @default("A4")
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  spdList        Spd[]
}

model Pegawai {
  id        String   @id @default(cuid())
  nip       String   @unique
  nama      String
  pangkat   String
  golongan  String
  jabatan   String
  unitKerja String   @default("Sekretariat Daerah")
  isASN     Boolean  @default(true)

  user      User?
  spdList   Spd[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Spd {
  id               String    @id @default(cuid())
  nomorSpd         String    @unique
  pemberiPerintah  String
  pegawaiId        String
  pegawai          Pegawai   @relation(fields: [pegawaiId], references: [id])
  dalamRangka      String
  alatAngkut       String
  tempatBerangkat  String
  tempatTujuan     String
  lamaHari         Int
  tanggalBerangkat DateTime
  tanggalKembali   DateTime
  skpd             String    @default("Bagian Umum Sekretariat Daerah Kab. Banggai Laut")
  kodeRekening     String?
  tingkatBiaya     String?
  pengikut         String?
  keterangan       String?
  kopSuratId       String?
  kopSurat         KopSurat? @relation(fields: [kopSuratId], references: [id], onDelete: SetNull)
  status           String    @default("DRAFT")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

