        <mxCell id="m1" value="1. Input credentials (Username/NIP, Password)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#0f172a;strokeWidth=1.2;fontColor=#0f172a;fontSize=10;align=center;verticalAlign=bottom;" edge="1" parent="1">
